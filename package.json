{
	"name": "chat",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k \"npm:front\" \"npm:fake-api\"",
		"front": "vite",
		"fake-api": "json-server --watch fake-api/data.json --host 127.0.0.1 --port 3000 -m fake-api/middleware.cjs",
		"build": "vue-tsc -b && vite build",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"preview": "vite preview"
	},
	"dependencies": {
		"pinia": "^3.0.4",
		"vue": "^3.5.21",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.4.11",
		"@vue/tsconfig": "^0.8.1",
		"concurrently": "^10.0.4",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-vue": "^10.10.0",
		"jsdom": "^29.1.1",
		"json-server": "^0.17.4",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^7.1.7",
		"vitest": "^4.1.10",
		"vue-tsc": "^3.3.9"
	}
}
